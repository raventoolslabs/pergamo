  "keywords": [],
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "body-parser": "^2.3.0",
    "bullmq": "^6.3.4",
    "clamscan": "^2.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fs-extra": "^11.4.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "multer": "^2.3.0",
    "mv": "^2.1.1",
    "officeparser": "^7.8.0",
    "owasp-password-strength-test": "^1.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc && tsc-alias && node -e \"const fs=require('fs');fs.cpSync('src/infrastructure/db/sql','dist/infrastructure/db/sql',{recursive:true});fs.cpSync('src/infrastructure/db/migrations','dist/infrastructure/db/migrations',{recursive:true})\"",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "init": "node dist/init.js",
    "start": "node dist/index.js",
    "rescan": "node dist/scripts/rescan.js",
    "reindex": "node dist/scripts/reindex.js",
    "worker": "node dist/worker.js",
    "scan:release": "node dist/scripts/release.js",
    "dev": "node dev.js",
    "dev:api": "npx ts-node -r tsconfig-paths/register src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "dev:init": "npx ts-node -r tsconfig-paths/register src/init.ts",
    "dev:seed": "npx ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "dev:worker": "npx ts-node -r tsconfig-paths/register src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest --detectOpenHandles",
    "test:e2e": "./e2e/run.sh"
  }
}
