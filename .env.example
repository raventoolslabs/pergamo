DIR_DATA=
PORT=3000
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
DB_SSL=false
# Activa el nivel de log 'debug', que registra metadatos completos de fichero y
# documento. Mantener en false en produccion.
DEBUG=false
# Analisis antivirico de las subidas. Acepta true/1/yes/on y false/0/no/off sin
# distinguir mayusculas; un valor no reconocido DETIENE el arranque en lugar de
# desactivar el escaneo en silencio.
ENABLE_ANTIVIRUS=true
# Destino de clamd. Con ENABLE_ANTIVIRUS activo hay que definir CLAMAV_HOST o
# CLAMAV_SOCKET: sin uno de los dos el arranque falla. Con docker-compose,
# CLAMAV_HOST lo fija el propio compose al nombre del servicio ('clamav').
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Alternativa a host/puerto para un clamd local por socket unix.
#CLAMAV_SOCKET=/run/clamav/clamd.sock
# Tiempo maximo (ms) de una operacion contra clamd.
CLAMAV_TIMEOUT=60000
# Reintentos de conexion al arrancar. clamd tarda decenas de segundos en cargar
# las firmas; sin reintentos, un arranque simultaneo deja la API en crash-loop.
CLAMAV_INIT_RETRIES=10
CLAMAV_INIT_RETRY_DELAY_MS=3000
REMOVE_FILE_DISK=true
# Limpieza de temporales huerfanos en data/tmp: antiguedad minima para borrar y
# periodo del barrido, en milisegundos.
TMP_MAX_AGE_MS=3600000
TMP_CLEANUP_INTERVAL_MS=900000
# Caducidad de los tokens emitidos en /organization/login (formato de jsonwebtoken: 30m, 8h, 7d...)
JWT_EXPIRES_IN=8h
# Saltos de proxy inverso en los que confiar para resolver la IP del cliente.
# 0 = no confiar en ninguno. Necesario para que el rate limiting no agrupe a todos los clientes.
TRUST_PROXY=0
# Ventana (ms) y numero maximo de peticiones por IP en los endpoints de credenciales
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
VALID_METADATA_MODIFY="name; description; tags"
VALID_MIMETYPE="application/pdf;application/vnd.oasis.opendocument.text"
MAX_VERSION_FILES=3
# Tamano maximo por fichero subido, en bytes (por defecto 50 MB).
# IMPORTANTE: si lo cambias, ajusta tambien MaxFileSize, MaxScanSize y
# StreamMaxLength en clamav/clamd.conf. Deben ser SIEMPRE mayores o iguales que
# este valor: por debajo, ClamAV deja de analizar por completo los ficheros mas
# grandes.
MAX_FILE_SIZE=52428800
USER_MASTER=
PASSWORD_MASTER=