# Entorno de DESARROLLO. Copia este fichero a .env y rellena DB_PASSWORD.
#
#   cp .env.example .env
#
# La base de datos vive en el contenedor 'postgres' del host, junto a las demas
# (steamfront, steamfront_test, pergamo). Preparacion, una sola vez:
#
#   docker exec -i postgres psql -U <superusuario> <<'SQL'
#     CREATE ROLE pergamo_dev LOGIN PASSWORD '<contrasena>';
#     CREATE DATABASE pergamo_dev OWNER pergamo_dev;
#   SQL
#   docker exec postgres psql -U <superusuario> -d pergamo_dev -c '
#     CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
#     CREATE EXTENSION IF NOT EXISTS pgcrypto;
#     CREATE EXTENSION IF NOT EXISTS unaccent;
#     CREATE EXTENSION IF NOT EXISTS vector;
#     GRANT ALL ON SCHEMA public TO pergamo_dev;'
#
# Las cuatro extensiones las crea el SUPERUSUARIO: no son «trusted», asi que el
# rol de la aplicacion no puede instalarlas. Una vez estan, el
# `CREATE EXTENSION IF NOT EXISTS` de src/config/init.sql las encuentra y sigue.

# Vacio: los datos van a ./data dentro del repositorio.
DIR_DATA=
# La API va al 3001 porque el 3000 lo ocupa la interfaz de Vite, que es la
# puerta de entrada: el mismo puerto que publica el contenedor, para que el
# proxy inverso apunte siempre ahi. Los dos entornos comparten ese puerto a
# proposito, asi que solo puede correr uno de los dos a la vez.
PORT=3001

# Host publico por el que se llega a la interfaz a traves del proxy inverso.
# Vacio para trabajar solo en local: Vite acepta siempre localhost. Con un valor
# aqui, ademas se admite ese Host (si no, responde «Blocked request») y el
# websocket del HMR se dirige al 443 del proxy en lugar del puerto de Vite.
PERGAMO_WEB_HOST=

# Puerto de la interfaz. Solo hace falta tocarlo para levantar el entorno de
# desarrollo con el contenedor en marcha, que es justo lo que el 3000 impide.
#PERGAMO_DEV_WEB_PORT=3000

DB_USERNAME=pergamo_dev
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pergamo_dev
DB_SSL=false

# En desarrollo si interesa el detalle de cada fichero y documento.
DEBUG=true

# Sin antivirus: arranca en segundos y no hace falta clamd. Para probar la
# cuarentena de verdad esta el recorrido de e2e/, que fuerza los estados por SQL.
ENABLE_ANTIVIRUS=false

# A donde se conecta clamd. Dejarlo todo vacio significa el socket local
# /run/clamav/clamd.ctl, que es donde escucha un clamav-daemon instalado del
# paquete: el de Debian declara LocalSocket y ningun TCPSocket, asi que un TCP a
# 127.0.0.1:3310 se rechaza aunque el demonio este vivo y con las firmas al dia.
# Si tu distribucion pone el socket en otra ruta, sale de LocalSocket en
# /etc/clamav/clamd.conf.
#
# Declarar CLAMAV_HOST cambia a TCP y desactiva ese defecto; es lo que hace el
# compose de docker/, que apunta al nombre del servicio. Ojo si quieres usar ese
# contenedor desde aqui: NO publica el 3310 al host a proposito —clamd no
# autentica—, asi que hay que publicarlo antes.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_SOCKET=
REMOVE_FILE_DISK=true

JWT_EXPIRES_IN=8h
TRUST_PROXY=0

# Holgado a proposito: con el valor de produccion (10 por IP) se agota
# entrando y saliendo un rato mientras se programa.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

VALID_METADATA_MODIFY="name; description; tags"
# Ampliar esta lista NO basta: verifyMimetype es fail-closed, asi que un
# mimetype sin firma en infrastructure/files/filetype.ts se rechaza con un 400.
# HTML, Markdown, CSV y texto plano no tienen magic bytes y por eso no estan.
VALID_MIMETYPE="application/pdf;application/rtf;application/epub+zip;application/vnd.oasis.opendocument.text;application/vnd.oasis.opendocument.spreadsheet;application/vnd.oasis.opendocument.presentation;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.presentationml.presentation"
MAX_VERSION_FILES=3

# Reglas del filtro de contenido activo que este despliegue NO aplica, separadas
# por ';'. Vacio = se aplican todas.
#
# Un PDF con JavaScript, accion al abrir o ficheros embebidos se deposita y queda
# en cuarentena ('malicious'): se guarda, no se descarga, y solo sale de ahi
# con `npm run scan:release -- <id>`. Un reescaneo NO lo libera.
#
# Cuando esto estorba: un archivo de documentos FIRMADOS los retiene todos, porque
# PAdES-LTV embebe OCSP y CRLs como ficheros embebidos (y Factur-X, el XML de la
# factura). En ese caso:
#
#   MALICIOUS_ACTIVE_CONTENT_IGNORE="EmbeddedFile"
#
# Reglas: JavaScript, OpenAction, AdditionalAction, Launch, EmbeddedFile,
# RichMedia, RemoteGoTo, SubmitForm, XFA, JavaScriptURI. Un nombre que no exista
# detiene el arranque, en vez de dejarte creyendo que has exceptuado algo.
MALICIOUS_ACTIVE_CONTENT_IGNORE=
MAX_FILE_SIZE=52428800

# La organizacion inicial 'pergamo' se crea con esta misma contrasena.
# Entrecomillada: lleva '#' y dotenv trataria el resto de la linea como comentario.
USER_MASTER=master
PASSWORD_MASTER="Pergamo0123#"

# --- Indexacion semantica ---------------------------------------------------
#
# Desactivada: con INDEXING_ENABLED=false Pergamo se comporta exactamente como
# antes de que existiera. Activarla exige pgvector en la base y una maquina de
# inferencia a la que pedir vectores.
INDEXING_ENABLED=false

# El worker: embebido en el mismo proceso que la API (comodo en desarrollo) o
# suelto (produccion, donde el compose lo levanta en su propio contenedor).
INDEXING_WORKER_EMBEDDED=true
INDEXING_CONCURRENCY=1

# Redis es solo el transporte de la cola. El estado de verdad vive en
# PostgreSQL, asi que perderlo no pierde nada que no recupere `npm run reindex`.
REDIS_URL=redis://127.0.0.1:6379
INDEXING_QUEUE_PREFIX=pergamo

# Un documento que lleva mas de esto en 'indexing' es un worker que murio a
# media faena: lo devuelve a la cola el siguiente barrido.
INDEXING_STALE_AFTER_MS=3600000

# Un solo cliente cubre Ollama, vLLM y OpenAI. La URL incluye el /v1.
#
#   Ollama:  EMBEDDING_BASE_URL=http://maquina-ia:11434/v1
#            EMBEDDING_MODEL=bge-m3            (sin clave)
#   OpenAI:  EMBEDDING_BASE_URL=https://api.openai.com/v1
#            EMBEDDING_MODEL=text-embedding-3-small
#            EMBEDDING_API_KEY=sk-...
#
# Con OpenAI el contenido de los documentos SALE de la instalacion. Es una
# decision del despliegue, no un detalle: para un fondo con documentos de
# clientes, la maquina propia es lo que evita ese viaje.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# Forma parte del esquema: la columna del indice se crea con esta anchura y
# cambiarla obliga a reindexar. El arranque aborta si dejan de coincidir.
#
# Se pide al proveedor con el parametro `dimensions`, asi que un modelo de otra
# anchura nativa —los text-embedding-3 de OpenAI son 1536— entrega vectores de
# este tamano y cambiar de proveedor no exige una version nueva del indice.
# Tope de 2000: es lo que admite un indice HNSW sobre el tipo `vector`.
EMBEDDING_DIMENSION=1024

# Mandar los trozos por lotes es lo que mas afecta al tiempo de una
# reindexacion completa.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=120000

# Tamanos del troceado, en caracteres. Superar INDEX_MAX_CHUNKS marca el
# documento como no indexable: casi siempre es una extraccion que salio mal.
INDEX_CHUNK_SIZE=1500
INDEX_CHUNK_OVERLAP=200
INDEX_MAX_CHUNKS=2000

# Cuantos candidatos trae cada mitad de la busqueda antes de fusionar, como
# multiplo de lo que se devuelve. Pedir de mas y recortar es lo que deja sitio a
# un reranker sin tocar el endpoint.
SEARCH_CANDIDATES_FACTOR=4

# Tope por documento: el conversor abre ficheros no confiables.
INDEX_CONVERT_TIMEOUT=300000
