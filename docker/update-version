#!/bin/bash

URL_VERSION=http://localhost:6231/api/version
CONTAINER=pergamo

set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

version() {
    local body
    # El puerto no esta publicado en el host: se consulta desde dentro del contenedor
    body=$(docker exec "$CONTAINER" wget -qO- -T 5 "$URL_VERSION" 2>/dev/null) || { echo 'N/A'; return 0; }
    if [[ $body =~ \"version\":\"([^\"]+)\" ]]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo 'N/A'
    fi
}

before=$(version)
docker compose pull
docker compose up -d
for _ in {1..30}; do
    after=$(version)
    [[ $after != 'N/A' ]] && break
    sleep 2
done
echo "before: $before  after: $after"

if [[ $after == 'N/A' ]] || [[ $after == "$before" ]]; then
    echo '[FAIL] Update version'
    exit 1
fi
echo '[OK] Update version'
