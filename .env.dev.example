# Entorno de DESARROLLO. Copia este fichero a .env y rellena DB_PASSWORD.
#
#   cp .env.dev.example .env
#
# La base de datos vive en el contenedor 'postgres' del host, junto a las demas
# (steamfront, steamfront_test, pergamo). Preparacion, una sola vez:
#
#   docker exec -i postgres psql -U <superusuario> <<'SQL'
#     CREATE ROLE pergamo_dev LOGIN PASSWORD '<contrasena>';
#     CREATE DATABASE pergamo_dev OWNER pergamo_dev;
#   SQL
#   docker exec postgres psql -U <superusuario> -d pergamo_dev -c '
#     CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
#     CREATE EXTENSION IF NOT EXISTS pgcrypto;
#     CREATE EXTENSION IF NOT EXISTS unaccent;
#     GRANT ALL ON SCHEMA public TO pergamo_dev;'
#
# Las tres extensiones las crea el SUPERUSUARIO: no son «trusted», asi que el
# rol de la aplicacion no puede instalarlas. Una vez estan, el
# `CREATE EXTENSION IF NOT EXISTS` de src/config/init.sql las encuentra y sigue.

# Vacio: los datos van a ./data dentro del repositorio.
DIR_DATA=
# El 3000 lo ocupa el contenedor de produccion (/opt/docker/pergamo).
PORT=3001

DB_USERNAME=pergamo_dev
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pergamo_dev
DB_SSL=false

# En desarrollo si interesa el detalle de cada fichero y documento.
DEBUG=true

# Sin antivirus: arranca en segundos y no hace falta clamd. Para probar la
# cuarentena de verdad esta el recorrido de e2e/, que fuerza los estados por SQL.
ENABLE_ANTIVIRUS=false
REMOVE_FILE_DISK=true

JWT_EXPIRES_IN=8h
TRUST_PROXY=0

# Holgado a proposito: con el valor de produccion (10 por IP) se agota
# entrando y saliendo un rato mientras se programa.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

VALID_METADATA_MODIFY="name; description; tags"
VALID_MIMETYPE="application/pdf;application/vnd.oasis.opendocument.text"
MAX_VERSION_FILES=3
MAX_FILE_SIZE=52428800

# La organizacion inicial 'pergamo' se crea con esta misma contrasena.
# Entrecomillada: lleva '#' y dotenv trataria el resto de la linea como comentario.
USER_MASTER=master
PASSWORD_MASTER="Pergamo0123#"
